# Server
NODE_ENV=production
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>

# Auth — JWT
JWT_SECRET=<strong-random-secret>
JWT_REFRESH_SECRET=<strong-random-separate-secret>

# Admin bootstrap credentials (change defaults!)
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=<strong-password>

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USE_CLOUDINARY=true

# CORS — comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-admin.vercel.app

# Email (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Twilio (OTP SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Upstash Redis (REST API — serverless-friendly, no TCP needed)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CloudAMQP / RabbitMQ (event bus for async workflows)
CLOUDAMQP_URL=amqps://<user>:<password>@<host>/<vhost>
