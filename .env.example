# Server
NODE_ENV=production
PORT=5001

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>

# Auth
JWT_SECRET=<strong-random-secret>
JWT_REFRESH_SECRET=<strong-random-secret>
JWT_EXPIRES_IN=1d

# Admin bootstrap credentials (change defaults!)
ADMIN_EMAIL=admin@yourstore.com
ADMIN_PASSWORD=<strong-password>
ADMIN_JWT_SECRET=<strong-random-secret>

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USE_CLOUDINARY=true

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=https://your-frontend.vercel.app,https://your-admin.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app

# Email (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Twilio (OTP SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
